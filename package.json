{
  "name": "defender-server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative multiplayer backend (WebSocket) for the Defender game.",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "npm install --include=dev && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ws": "^8.18.0",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
