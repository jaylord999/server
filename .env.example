# --- Server ---
# Port the HTTP + WebSocket server listens on. Render injects PORT automatically.
PORT=10000
NODE_ENV=development

# Host to bind. Keep 0.0.0.0 for cloud deployment (Render).
HOST=0.0.0.0

# --- Heartbeat ---
# Server pings every HEARTBEAT_INTERVAL_MS; if no activity for
# HEARTBEAT_TIMEOUT_MS the connection is considered dead and closed.
HEARTBEAT_INTERVAL_MS=15000
HEARTBEAT_TIMEOUT_MS=45000

# --- Simulation / network ---
# Authoritative simulation + broadcast rate (ticks per second).
TICK_RATE=20
GAME_TIME_LIMIT_SECONDS=300

# --- Gameplay ---
# Maximum total energy available for power allocation.
MAX_POWER=100
# Maximum power a single system may receive.
MAX_POWER_PER_SYSTEM=100
# Minimum time between shots (server-authoritative).
WEAPON_COOLDOWN_MS=200
# Maximum aircraft speed (units/second) used by the minimal movement sim.
MAX_PLAYER_SPEED=10
